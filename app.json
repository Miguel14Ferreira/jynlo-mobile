{
  "expo": {
    "name": "Jynlo",
    "slug": "jynlo-mobile",
    "scheme": "jynlo",
    "version": "0.16.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/jynlo-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jynlo.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "A Jynlo utiliza o microfone apenas quando participas numa chamada de voz ou vídeo.",
        "NSCameraUsageDescription": "A Jynlo utiliza a câmara quando decides participar numa chamada de vídeo."
      }
    },
    "android": {
      "package": "com.jynlo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/jynlo-icon.png",
        "backgroundColor": "#07171D"
      },
      "versionCode": 7,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/login/registerNewUser/confirmTokenRegistration/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/login/resetPassword/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/menu/communities/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/sessions/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/venues/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Jynlo precisa de acesso às fotos selecionadas para partilhares Stories e publicações.",
          "cameraPermission": "A Jynlo usa a câmara apenas quando escolhes tirar uma fotografia."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#07171D",
          "defaultChannel": "jynlo-messages"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
