{
  "expo": {
    "name": "Jynlo",
    "slug": "jynlo-mobile",
    "scheme": "jynlo",
    "version": "0.9.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/jynlo-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jynlo.app"
    },
    "android": {
      "package": "com.jynlo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/jynlo-icon.png",
        "backgroundColor": "#07171D"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Jynlo precisa de acesso às fotos selecionadas para partilhares Stories e publicações.",
          "cameraPermission": "A Jynlo usa a câmara apenas quando escolhes tirar uma fotografia."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
