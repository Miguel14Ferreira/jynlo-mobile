{
  "expo": {
    "name": "Jynlo",
    "slug": "jynlo-mobile",
    "scheme": "jynlo",
    "version": "0.18.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/jynlo-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jynlo.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "A Jynlo utiliza o microfone quando gravas vídeos com som ou participas numa chamada de voz ou vídeo.",
        "NSCameraUsageDescription": "A Jynlo utiliza a câmara quando tiras fotografias, gravas Stories ou participas numa chamada de vídeo.",
        "NSLocationWhenInUseUsageDescription": "A Jynlo usa a tua localização para mostrar jogos e recintos perto de ti e para marcar o local de um jogo que crias.",
        "NSPhotoLibraryUsageDescription": "A Jynlo precisa de acesso às fotos que escolheres para partilhares Stories, publicações e a foto de perfil.",
        "NSPhotoLibraryAddUsageDescription": "A Jynlo guarda na tua galeria as fotos que decidires descarregar.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:jynlosports.com",
        "applinks:d24sports.com"
      ]
    },
    "android": {
      "package": "com.jynlo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/jynlo-icon.png",
        "backgroundColor": "#07171D"
      },
      "versionCode": 15,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/login/registerNewUser/confirmTokenRegistration/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/login/registerNewUser/confirmTokenRegistration/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/login/resetPassword/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/login/resetPassword/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/menu/communities/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/menu/communities/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/sessions/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/sessions/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/posts/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/posts/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/menu/events/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/menu/events/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/venues/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/venues/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "d24sports.com",
              "pathPrefix": "/menu/teams/claim/"
            },
            {
              "scheme": "https",
              "host": "jynlosports.com",
              "pathPrefix": "/menu/teams/claim/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Jynlo precisa de acesso às fotos selecionadas para partilhares Stories e publicações.",
          "cameraPermission": "A Jynlo usa a câmara quando escolhes tirar fotografias ou gravar vídeos."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#07171D",
          "defaultChannel": "jynlo-messages"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Jynlo usa a tua localização para mostrar jogos e recintos perto de ti e para marcar o local de um jogo que crias."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
