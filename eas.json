{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_JYNLO_API_URL": "https://desporto24-preview-api.onrender.com",
        "JYNLO_REQUIRE_REAL_API": "1",
        "JYNLO_ANDROID_DIAGNOSTIC_NO_R8": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "env": {
        "JYNLO_REQUIRE_REAL_API": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "push-test": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_JYNLO_API_URL": "https://desporto24-preview-api.onrender.com",
        "JYNLO_REQUIRE_REAL_API": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "play-internal": {
      "distribution": "store",
      "env": {
        "JYNLO_REQUIRE_REAL_API": "1"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "diagnostic": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_JYNLO_API_URL": "https://desporto24-preview-api.onrender.com",
        "JYNLO_REQUIRE_REAL_API": "1",
        "JYNLO_ANDROID_DIAGNOSTIC_NO_R8": "1"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "environment": "preview"
    },
    "ios-testflight": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_JYNLO_API_URL": "https://desporto24-preview-api.onrender.com",
        "JYNLO_REQUIRE_REAL_API": "1"
      },
      "ios": {}
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "ios-testflight": {
      "ios": {}
    }
  }
}
