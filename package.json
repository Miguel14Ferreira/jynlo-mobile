{
  "name": "jynlo-mobile",
  "version": "0.9.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --test tests/*.test.cjs",
    "doctor": "expo-doctor",
    "test:syntax": "node tests/check-ts-syntax.cjs",
    "test:all": "node tests/check-ts-syntax.cjs && node --test tests/*.test.cjs",
    "eas-build-pre-install": "node scripts/verify-release.cjs",
    "check:release": "node scripts/verify-release.cjs --production"
  },
  "dependencies": {
    "expo": "~58.0.22",
    "expo-router": "~58.0.29",
    "expo-linking": "~58.0.15",
    "expo-constants": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "expo-image-picker": "~58.0.10",
    "expo-video": "~58.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
