{
  "name": "jynlo-mobile",
  "version": "0.17.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --test tests/*.test.cjs",
    "doctor": "expo-doctor",
    "test:syntax": "node tests/check-ts-syntax.cjs",
    "test:all": "node tests/check-ts-syntax.cjs && node --test tests/*.test.cjs",
    "eas-build-pre-install": "node scripts/verify-release.cjs && bash scripts/prepare-jynlo-icon.sh",
    "check:release": "node scripts/verify-release.cjs --production",
    "check:push": "node scripts/check-push-readiness.cjs",
    "check:app-links": "node scripts/check-android-app-links.cjs"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/vector-icons": "15.0.3",
    "@livekit/react-native": "3.1.0",
    "@livekit/react-native-expo-plugin": "1.1.0",
    "@livekit/react-native-webrtc": "150.1.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.3",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.21",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.1.0",
    "livekit-client": "2.23.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.3.0"
  }
}
